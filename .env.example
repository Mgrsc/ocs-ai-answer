# Required: API key for an OpenAI-compatible provider
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: Chat Completions endpoint
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional: model name supported by the upstream provider
OPENAI_MODEL=gpt-4o-mini

# Optional: compact system prompt focused on the response contract
SYSTEM_PROMPT=Return exactly one JSON object with two string fields: "question" and "answer". Copy the user question exactly into "question". Put the best direct answer into "answer". If the answer cannot be determined, set "answer" to "无法找到答案". Do not output markdown, code fences, explanations, or extra keys.

# Optional: Bun service port
PORT=3000

# Optional: log incoming request keys and field previews for debugging OCS payloads
DEBUG_REQUEST_DETAILS=false
