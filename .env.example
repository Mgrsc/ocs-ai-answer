# Required: API key for an OpenAI-compatible provider
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: Chat Completions endpoint
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional: model name supported by the upstream provider
OPENAI_MODEL=gpt-4o-mini

# Optional: client authentication token (e.g. your-client-token); if set, POST /answer requires Authorization: Bearer <CLIENT_API_KEY> or X-API-Key
# CLIENT_API_KEY=your-client-secret-key

# Optional: override the built-in default prompt; if omitted, the service uses an internal prompt that enforces OCS answer formatting rules
SYSTEM_PROMPT=Return exactly one JSON object with two string fields: "question" and "answer". Copy the user question exactly into "question". Put only the final answer into "answer". If the answer cannot be determined, set "answer" to "不知道". For single-choice and judgement questions, answer with exactly one provided option. For multiple-choice questions, return all correct options joined by "#", preserving the original option text order from the user input. Do not output markdown, code fences, explanations, or extra keys.

# Optional: fallback text returned when the upstream model cannot determine the answer (default: 不知道)
# NO_ANSWER="不知道"

# Optional: Bun service port
PORT=3000

# Optional: log incoming request keys and field previews for debugging OCS payloads
DEBUG_REQUEST_DETAILS=false

# Optional: comma-separated host patterns for image fetch allowlist (e.g. *.chaoxing.com,*.ananas.chaoxing.com); if unset, global SSRF defenses still protect private and loopback networks
# ALLOWED_IMAGE_HOSTS=*.chaoxing.com,*.ananas.chaoxing.com

# Optional: maximum requests allowed per IP per minute (default: 60, range: 0-10000, set to 0 to disable)
# RATE_LIMIT_PER_MINUTE=60

# Optional: IP ban duration in milliseconds when high-risk scanner paths are detected (default: 3600000 = 1 hour, range: 1000-2592000000)
# IP_BLOCK_DURATION_MS=3600000

# Optional: trust X-Forwarded-For and X-Real-IP proxy headers when running behind a single trusted reverse proxy like Nginx (default: false)
# TRUST_PROXY=true

